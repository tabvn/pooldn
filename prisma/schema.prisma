generator client {
  provider = "prisma-client"
  output   = "../lib/generated/prisma"
}

generator pothos {
  provider     = "prisma-pothos-types"
  clientOutput = "@/lib/generated/prisma/client"
  output       = "../lib/generated/pothos-types.ts"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ─────────────────────────────────────────────────────────────────────────────
// Enums
// ─────────────────────────────────────────────────────────────────────────────

enum UserRole {
  SUPER_ADMIN
  ORGANIZER
  TEAM_CAPTAIN
  PLAYER
  VIEWER
}

enum CompetitionStatus {
  DRAFT
  OPEN_FOR_APPLICATIONS
  APPLICATIONS_CLOSED
  ONGOING
  COMPLETED
  CANCELLED
}

enum CompetitionFormat {
  ROUND_ROBIN
  SINGLE_ELIMINATION
  DOUBLE_ELIMINATION
  SWISS
}

enum CompetitionType {
  TEAMS
  // 1v1 — a player applies solo, no team required.
  INDIVIDUAL
  // Round-53 — 2v2 — captain applies with a team that has exactly two
  // players. We keep TEAMS for >2-player rosters; DOUBLES is the
  // narrower lane so the apply form and the matchday generator can
  // assume "two-versus-two" without inspecting roster size every time.
  DOUBLES
}

enum GameType {
  EIGHT_BALL
  NINE_BALL
  TEN_BALL
  STRAIGHT_POOL
}

enum ApplicationStatus {
  PENDING
  APPROVED
  REJECTED
  CANCELLED
  WAITLISTED
  // Round-49 — organizer-initiated batch invite. Team captain must accept
  // (transitions to PENDING via applyToCompetition) or decline (CANCELLED).
  INVITED
}

enum MatchStatus {
  SCHEDULED
  IN_PROGRESS
  COMPLETED
  CANCELLED
  POSTPONED
}

enum SchedulingType {
  FIXED_DATE
  FLEXIBLE
  AUTO_GENERATED
  // Round-48 (wizard) — Figma "Scheduling Type" tabbed selector replaces the
  // old enum with two modes. We keep the existing values for backwards
  // compatibility and add WEEKLY_ROUNDS + FIXED_MATCHDAYS for new comps.
  WEEKLY_ROUNDS
  FIXED_MATCHDAYS
}

enum ApplicationMode {
  OPEN
  INVITE_ONLY
}

enum MatchVenueMode {
  TEAM_VENUES
  CENTRAL_VENUE
}

enum FeedbackType {
  BUG
  FEATURE
  OTHER
}

// Round-49 — persistent outgoing-email queue. Lets us drop mailer calls
// out of request-time mutations: inviteTeamsToCompetition (and any future
// caller) writes a row, the response returns immediately, then Next.js
// after() / a cron drains the queue and actually fires SMTP.
enum OutgoingEmailStatus {
  PENDING
  SENT
  FAILED
  // Skipped at enqueue-time. Used today for *.local addresses in test
  // fixtures so seed users don't bounce a real Gmail send.
  SKIPPED
}

enum FeedbackStatus {
  NEW
  REVIEWING
  RESOLVED
  CLOSED
}

model Feedback {
  id           String         @id @default(cuid())
  userId       String?
  user         User?          @relation("FeedbackAuthor", fields: [userId], references: [id], onDelete: SetNull)
  contactEmail String?
  type         FeedbackType   @default(OTHER)
  subject      String
  message      String
  status       FeedbackStatus @default(NEW)
  adminNote    String?
  resolvedById String?
  resolvedBy   User?          @relation("FeedbackResolver", fields: [resolvedById], references: [id], onDelete: SetNull)
  resolvedAt   DateTime?
  createdAt    DateTime       @default(now())
  updatedAt    DateTime       @updatedAt

  @@index([status])
  @@index([createdAt])
  @@map("feedback")
}

enum NotificationType {
  WELCOME
  APPLICATION_SUBMITTED
  APPLICATION_APPROVED
  APPLICATION_REJECTED
  APPLICATION_WAITLISTED
  COMPETITION_STARTED
  COMPETITION_COMPLETED
  MATCH_SCHEDULED
  MATCH_RESULT_RECORDED
  ROSTER_INVITE
  // Round-48 — fired when a non-playing team captain nominates a player
  // as the per-competition Roster Captain. Recipient is the chosen player.
  ROSTER_CAPTAIN_ASSIGNED
  // Round-49 — fired when an organizer batch-invites a team to a
  // competition. Recipient is the team captain + every team member.
  COMPETITION_INVITE
  COMMUNITY_LIKE
  COMMUNITY_COMMENT
  COMMUNITY_REPLY
  COMMUNITY_MENTION
  COMMUNITY_QUOTE
}

enum NotificationEntityType {
  COMPETITION
  APPLICATION
  MATCH
  TEAM
  USER
  COMMUNITY_POST
}

enum GameBlockType {
  SINGLES
  DOUBLES
  SCOTCH_DOUBLES
}

// ─────────────────────────────────────────────────────────────────────────────
// Identity
// ─────────────────────────────────────────────────────────────────────────────

model User {
  id            String   @id @default(cuid())
  name          String
  username      String   @unique
  email         String   @unique
  password      String
  role          UserRole @default(PLAYER)
  avatarUrl     String?
  bio           String?
  phone         String?
  // Country of origin — required. PoolDN is for international players, so
  // every player has a nationality (2-letter country code).
  nationality   String
  // Location is required — city is the app's top-level content filter, so
  // every player belongs to one. New accounts default to the home city in
  // code (see defaultUserLocation) until onboarding / geolocation refines it.
  cityId        String
  emailVerified Boolean  @default(false)
  isActive      Boolean  @default(true)
  // Round-46 — admin-managed lockout. When `bannedAt` is set the user can't
  // access ANY page or call ANY mutation; they only see the "your account
  // is banned" screen. `banReason` is shown on that screen verbatim.
  bannedAt      DateTime?
  banReason     String?
  // Round-54 — player rating + level removed for MVP. We'll add a points
  // model back once we decide how to compute it. The `rating` / `level`
  // columns are dropped via migration 20260611140000_drop_player_rating.
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  city                  City               @relation(fields: [cityId], references: [id])
  organizedCompetitions Competition[]      @relation("OrganizedBy")
  captainedTeams        Team[]             @relation("CaptainedBy")
  teamMemberships       TeamMember[]
  applicationPlayers    ApplicationPlayer[]
  rosterCaptainOf       CompetitionApplication[] @relation("ApplicationRosterCaptain")
  // Round-53 — INDIVIDUAL competition applications: the user is the
  // applicant directly (no team). Back-relation for the new
  // CompetitionApplication.applicantUserId column.
  competitionApplications CompetitionApplication[] @relation("CompetitionApplicant")
  rosterChangeRequested RosterChangeRequest[]    @relation("RosterChangeRequestedBy")
  rosterChangeReviewed  RosterChangeRequest[]    @relation("RosterChangeReviewedBy")
  rosterChangePlayerOf  RosterChangePlayer[]
  matchParticipations   MatchParticipant[]
  playerCompStats       PlayerCompStat[]
  notifications         Notification[]
  sessions              Session[]
  rosterEntries         CompetitionRoster[]
  scoreSubmissions      MatchScoreSubmission[] @relation("ScoreSubmittedBy")
  scoreReviews          MatchScoreSubmission[] @relation("ScoreReviewedBy")
  teamInvitationsReceived TeamInvitation[]      @relation("TeamInvitedUser")
  teamInvitationsSent     TeamInvitation[]      @relation("TeamInvitedBy")
  teamJoinRequests        TeamJoinRequest[]     @relation("JoinRequestUser")
  teamJoinReviews         TeamJoinRequest[]     @relation("JoinRequestReviewer")
  framesAsHomePlayer      MatchFrame[]          @relation("FrameHomePlayer")
  framesAsAwayPlayer      MatchFrame[]          @relation("FrameAwayPlayer")
  feedbackAuthored        Feedback[]            @relation("FeedbackAuthor")
  feedbackResolved        Feedback[]            @relation("FeedbackResolver")
  matchesCompleted        Match[]               @relation("MatchCompletedBy")
  blockLineupsSubmitted   MatchBlockLineup[]    @relation("BlockLineupSubmittedBy")
  notificationPreferences NotificationPreference[]
  digestRuns              DigestRun[]
  emailTokens             EmailToken[]
  securityEvents          SecurityEvent[]
  rescheduleRequests      MatchRescheduleRequest[] @relation("RescheduleRequestedBy")
  rescheduleReviews       MatchRescheduleRequest[] @relation("RescheduleReviewedBy")

  @@index([cityId])
  @@index([role])
  // Round-34 — generated tsvector for global search. Managed via raw SQL
  // migration (round50_restore_search_fts); declared as Unsupported so
  // Prisma never tries to alter or drop it during migrate dev.
  searchVector Unsupported("tsvector")?

  @@index([isActive])
  @@index([bannedAt])
  @@map("users")
}

model Session {
  id        String   @id @default(cuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  token     String   @unique
  expiresAt DateTime
  createdAt DateTime @default(now())

  @@index([userId])
  @@index([expiresAt])
  @@map("sessions")
}

// ─────────────────────────────────────────────────────────────────────────────
// Geography
// ─────────────────────────────────────────────────────────────────────────────

model Country {
  id     String @id @default(cuid())
  code   String @unique
  name   String
  cities City[]

  @@map("countries")
}

model City {
  id        String @id @default(cuid())
  name      String
  countryId String
  country   Country @relation(fields: [countryId], references: [id])
  isActive  Boolean @default(true)

  users        User[]
  venues       Venue[]
  competitions Competition[]
  teams        Team[]          @relation("TeamCity")

  @@unique([countryId, name])
  @@index([countryId])
  @@index([isActive])
  @@map("cities")
}

model Venue {
  id         String   @id @default(cuid())
  name       String
  slug       String   @unique
  address    String
  cityId     String
  city       City     @relation(fields: [cityId], references: [id])
  phone      String?
  email      String?
  website    String?
  imageUrl   String?
  tableCount Int?
  isActive   Boolean  @default(true)
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  matches Match[]
  homeTeams Team[] @relation("VenueHomeTeams")
  competitionsAsCentralVenue Competition[] @relation("CompetitionCentralVenue")

  // Round-34 generated tsvector — see User.searchVector for the rationale.
  searchVector Unsupported("tsvector")?

  @@index([cityId])
  @@index([isActive])
  @@map("venues")
}

// ─────────────────────────────────────────────────────────────────────────────
// Teams
// ─────────────────────────────────────────────────────────────────────────────

model Team {
  id          String   @id @default(cuid())
  name        String
  slug        String   @unique
  logoUrl     String?
  description String?
  captainId   String
  captain     User     @relation("CaptainedBy", fields: [captainId], references: [id])
  cityId      String?
  city        City?    @relation("TeamCity", fields: [cityId], references: [id])
  // Round-37 — a team's regular home venue. Surfaces on the venue page as
  // "Home teams" and on the team page as the headline location.
  homeVenueId String?
  homeVenue   Venue?   @relation("VenueHomeTeams", fields: [homeVenueId], references: [id], onDelete: SetNull)
  isActive    Boolean  @default(true)
  // Round-46 — admin can ban a team (members keep their data but the team is
  // locked: no roster edits, no new applications, no matches scheduled).
  bannedAt    DateTime?
  banReason   String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  members       TeamMember[]
  applications  CompetitionApplication[]
  homeMatches   Match[]                  @relation("HomeTeam")
  awayMatches   Match[]                  @relation("AwayTeam")
  standings     Standing[]
  rosterEntries CompetitionRoster[]
  scoreSubmissions MatchScoreSubmission[] @relation("ScoreForTeam")
  forfeitedMatches Match[]                @relation("ForfeitTeam")
  invitations   TeamInvitation[]
  joinRequests  TeamJoinRequest[]

  // Round-34 generated tsvector — see User.searchVector.
  searchVector Unsupported("tsvector")?

  @@index([captainId])
  @@index([isActive])
  @@map("teams")
}

enum TeamInviteStatus {
  PENDING
  ACCEPTED
  DECLINED
  CANCELLED
  EXPIRED
}

enum JoinRequestStatus {
  PENDING
  APPROVED
  REJECTED
  CANCELLED
}

model TeamInvitation {
  id            String           @id @default(cuid())
  teamId        String
  team          Team             @relation(fields: [teamId], references: [id], onDelete: Cascade)
  invitedUserId String?
  invitedUser   User?            @relation("TeamInvitedUser", fields: [invitedUserId], references: [id], onDelete: SetNull)
  email         String?
  invitedById   String
  invitedBy     User             @relation("TeamInvitedBy", fields: [invitedById], references: [id])
  status        TeamInviteStatus @default(PENDING)
  token         String           @unique @default(cuid())
  message       String?
  createdAt     DateTime         @default(now())
  respondedAt   DateTime?

  @@index([teamId])
  @@index([invitedUserId])
  @@index([status])
  @@map("team_invitations")
}

model TeamJoinRequest {
  id           String            @id @default(cuid())
  teamId       String
  team         Team              @relation(fields: [teamId], references: [id], onDelete: Cascade)
  userId       String
  user         User              @relation("JoinRequestUser", fields: [userId], references: [id], onDelete: Cascade)
  status       JoinRequestStatus @default(PENDING)
  message      String?
  createdAt    DateTime          @default(now())
  reviewedById String?
  reviewedBy   User?             @relation("JoinRequestReviewer", fields: [reviewedById], references: [id])
  reviewedAt   DateTime?

  @@unique([teamId, userId])
  @@index([userId])
  @@index([status])
  @@map("team_join_requests")
}

model TeamMember {
  id          String    @id @default(cuid())
  teamId      String
  team        Team      @relation(fields: [teamId], references: [id], onDelete: Cascade)
  userId      String
  user        User      @relation(fields: [userId], references: [id])
  joinedAt    DateTime  @default(now())
  isActive    Boolean   @default(true)
  // Round-20 — when a player leaves voluntarily, keep the row for history
  // and stamp the reason / timestamp instead of hard-deleting.
  leftAt      DateTime?
  leaveReason String?

  @@unique([teamId, userId])
  @@index([userId])
  @@map("team_members")
}

// ─────────────────────────────────────────────────────────────────────────────
// Competitions
// ─────────────────────────────────────────────────────────────────────────────

model Competition {
  id                  String            @id @default(cuid())
  slug                String            @unique
  name                String
  description         String?
  bannerUrl           String?
  organizerId         String
  organizer           User              @relation("OrganizedBy", fields: [organizerId], references: [id])
  cityId              String?
  city                City?             @relation(fields: [cityId], references: [id])
  status              CompetitionStatus @default(DRAFT)
  type                CompetitionType   @default(TEAMS)
  format              CompetitionFormat @default(ROUND_ROBIN)
  gameType            GameType          @default(EIGHT_BALL)
  maxTeams            Int?
  minTeams            Int               @default(2)
  maxPlayersPerTeam   Int?
  minPlayersPerTeam   Int               @default(1)
  raceToFrames        Int               @default(5)
  framesPerMatchday   Int?
  applicationDeadline DateTime?
  startDate           DateTime?
  endDate             DateTime?
  schedulingType      SchedulingType    @default(FLEXIBLE)
  prizePool           Decimal?          @db.Decimal(18, 2)
  currency            String            @default("VND")
  prizeDistribution   Json?
  pointsWin           Int               @default(3)
  pointsDraw          Int               @default(1)
  pointsLoss          Int               @default(0)
  isPublic            Boolean           @default(true)
  rulesUrl            String?
  // Rules
  breakAndRunRule     Boolean           @default(false)
  // Round-48 — Figma "Team Captain Application" gate: when true, the apply
  // flow blocks a team whose Team.homeVenueId is null, with the verbatim
  // copy "This competition requires each team to have a home venue."
  requiresHomeVenue   Boolean           @default(false)
  // Round-48 (wizard) — Figma "How Participants Apply" tabbed selector.
  // OPEN     = any team captain can apply (current behavior, default).
  // INVITE_ONLY = the organizer pre-lists which teams may apply;
  //               applyToCompetition rejects others. The list lives in
  //               `invitedTeamIds` (Json) until a richer model is needed.
  applicationMode     ApplicationMode   @default(OPEN)
  invitedTeamIds      Json?
  // Figma "Where Matches Are Played" tabbed selector.
  // TEAM_VENUES   = each match plays at the home team's home venue.
  // CENTRAL_VENUE = one neutral venue hosts everything (organizer-picked).
  matchVenueMode      MatchVenueMode    @default(TEAM_VENUES)
  centralVenueId      String?
  centralVenue        Venue?            @relation("CompetitionCentralVenue", fields: [centralVenueId], references: [id], onDelete: SetNull)
  // Figma "Games per Opponent": 1 = Only Once, 2 = Home & Away.
  gamesPerOpponent    Int               @default(1)
  // Figma "Scheduling Type" = Weekly Rounds: a list of (weekday, time)
  // rows feeding the matchday generator. Example:
  //   [{"weekday": 2, "time": "21:00"}, {"weekday": 5, "time": "21:00"}]
  // weekday: 0 = Sun, 1 = Mon, …, 6 = Sat (matches JS Date.getDay()).
  weekdaySchedule     Json?
  // Round-58 — Figma "Scheduling Type" = Fixed Match Day(s): explicit ISO
  // dates ("2026-07-04") the organizer picks one-by-one. Only read when
  // schedulingType === FIXED_MATCHDAYS.
  fixedMatchDates     Json?
  // Round-47 — scheduling cap from Figma. When set, the matchday generator
  // refuses to schedule more than this many matches at the same venue on
  // the same matchday. Null = no cap. UI input on the wizard Schedule step.
  maxGamesPerVenuePerMatchday Int?
  // Round-50 — organizer/admin locks. Independent of `status` so an ONGOING
  // competition can stay open for late-registration substitutions, and a
  // closed-registration competition can still let captains swap rosters.
  //
  //   registrationLocked = true → applyToCompetition + inviteTeamsToCompetition
  //                               reject (SUPER_ADMIN bypasses).
  //   rosterLocked       = true → captains cannot open a RosterChangeRequest.
  //
  // Both default false so existing competitions behave unchanged.
  registrationLocked  Boolean           @default(false)
  rosterLocked        Boolean           @default(false)
  createdAt           DateTime          @default(now())
  updatedAt           DateTime          @updatedAt

  applications CompetitionApplication[]
  matchdays    Matchday[]
  standings    Standing[]
  playerStats  PlayerCompStat[]
  blocks       MatchFormatBlock[]
  rosters      CompetitionRoster[]

  // Round-34 generated tsvector — see User.searchVector.
  searchVector Unsupported("tsvector")?

  @@index([organizerId])
  @@index([cityId])
  @@index([status])
  @@index([status, startDate])
  @@index([isPublic])
  @@map("competitions")
}

model CompetitionRoster {
  id            String      @id @default(cuid())
  competitionId String
  competition   Competition @relation(fields: [competitionId], references: [id], onDelete: Cascade)
  teamId        String
  team          Team        @relation(fields: [teamId], references: [id], onDelete: Cascade)
  userId        String
  user          User        @relation(fields: [userId], references: [id], onDelete: Cascade)
  createdAt     DateTime    @default(now())

  // A given user can only be rostered on ONE team per competition.
  @@unique([competitionId, userId])
  @@index([competitionId, teamId])
  @@map("competition_rosters")
}

model MatchFormatBlock {
  id             String        @id @default(cuid())
  competitionId  String
  competition    Competition   @relation(fields: [competitionId], references: [id], onDelete: Cascade)
  order          Int
  type           GameBlockType
  games          Int           @default(1)
  raceTo         Int?
  // Break between this block and the next one, in minutes.
  breakAfterMin  Int?
  createdAt      DateTime      @default(now())

  @@unique([competitionId, order])
  @@index([competitionId])
  @@map("match_format_blocks")
}

model CompetitionApplication {
  id            String            @id @default(cuid())
  competitionId String
  competition   Competition       @relation(fields: [competitionId], references: [id], onDelete: Cascade)
  // Round-53 — TEAMS / DOUBLES competitions still apply via a Team row,
  // but INDIVIDUAL (1v1) comps don't have one. Make teamId nullable and
  // add applicantUserId for the solo-applicant case. Exactly one of the
  // two is set per row (enforced in the resolver).
  teamId        String?
  team          Team?             @relation(fields: [teamId], references: [id])
  applicantUserId String?
  applicant       User?           @relation("CompetitionApplicant", fields: [applicantUserId], references: [id])
  status        ApplicationStatus @default(PENDING)
  message       String?
  reviewNote    String?
  reviewedAt    DateTime?
  submittedAt   DateTime          @default(now())
  updatedAt     DateTime          @updatedAt

  // Round-48 — per-competition Roster Captain. Set when the Team Captain
  // is NOT in the application's roster; the nominated player runs match
  // flow (lineups, score submission) for this competition. NULL when the
  // Team Captain is playing and acts as captain themselves.
  rosterCaptainUserId String?
  rosterCaptain       User?     @relation("ApplicationRosterCaptain", fields: [rosterCaptainUserId], references: [id])

  applicationPlayers ApplicationPlayer[]
  rosterChangeRequests RosterChangeRequest[]

  @@unique([competitionId, teamId])
  @@unique([competitionId, applicantUserId])
  @@index([teamId])
  @@index([applicantUserId])
  @@index([status])
  @@index([rosterCaptainUserId])
  @@map("competition_applications")
}

model ApplicationPlayer {
  id            String                 @id @default(cuid())
  applicationId String
  application   CompetitionApplication @relation(fields: [applicationId], references: [id], onDelete: Cascade)
  userId        String
  user          User                   @relation(fields: [userId], references: [id])
  name          String
  role          String?
  createdAt     DateTime               @default(now())

  @@unique([applicationId, userId])
  @@index([userId])
  @@map("application_players")
}

// Round-50 — captain-initiated roster swap on an APPROVED application.
// Captures the proposed roster atomically; CompetitionRoster + applicationPlayers
// stay locked to the previous set until an organizer/admin approves. Approval
// diffs the proposed set against the locked roster, then syncs both tables in
// one transaction. Rejection leaves both alone.
//
// Lifecycle: PENDING (captain just submitted) → APPROVED | REJECTED | CANCELLED.
//   CANCELLED = captain withdrew the request before review.
enum RosterChangeRequestStatus {
  PENDING
  APPROVED
  REJECTED
  CANCELLED
}

model RosterChangeRequest {
  id            String                    @id @default(cuid())
  applicationId String
  application   CompetitionApplication    @relation(fields: [applicationId], references: [id], onDelete: Cascade)
  requestedById String
  requestedBy   User                      @relation("RosterChangeRequestedBy", fields: [requestedById], references: [id])
  status        RosterChangeRequestStatus @default(PENDING)
  message       String?
  reviewNote    String?
  reviewedById  String?
  reviewedBy    User?                     @relation("RosterChangeReviewedBy", fields: [reviewedById], references: [id])
  reviewedAt    DateTime?
  submittedAt   DateTime                  @default(now())
  updatedAt     DateTime                  @updatedAt

  proposedPlayers RosterChangePlayer[]

  @@index([applicationId])
  @@index([status])
  @@index([requestedById])
  @@map("roster_change_requests")
}

model RosterChangePlayer {
  id        String              @id @default(cuid())
  requestId String
  request   RosterChangeRequest @relation(fields: [requestId], references: [id], onDelete: Cascade)
  userId    String
  user      User                @relation(fields: [userId], references: [id])

  @@unique([requestId, userId])
  @@index([userId])
  @@map("roster_change_players")
}

// ─────────────────────────────────────────────────────────────────────────────
// Schedule + Matches
// ─────────────────────────────────────────────────────────────────────────────

model Matchday {
  id            String      @id @default(cuid())
  competitionId String
  competition   Competition @relation(fields: [competitionId], references: [id], onDelete: Cascade)
  number        Int
  label         String?
  scheduledDate DateTime?
  startTime     String?
  endTime       String?
  // Round-64 — organizer note when a matchday is moved (holiday, venue clash,
  // …). Shown on the matchday card; set by shiftMatchdayOnward.
  note          String?
  isGenerated   Boolean     @default(false)
  createdAt     DateTime    @default(now())
  updatedAt     DateTime    @updatedAt

  matches Match[]

  @@unique([competitionId, number])
  @@index([scheduledDate])
  @@map("matchdays")
}

enum MatchWinType {
  NORMAL
  WALKOVER
  FORFEIT
  DOUBLE_FORFEIT
}

enum MatchCompletionMode {
  AUTO_AGREED          // both captains posted matching scores
  ORGANIZER_REVIEW     // organizer resolved a CONFLICT or set a manual result
  ADMIN_OVERRIDE       // SUPER_ADMIN finalized
  FORFEIT              // walkover / no-show
}

model Match {
  id          String      @id @default(cuid())
  matchdayId  String
  matchday    Matchday    @relation(fields: [matchdayId], references: [id], onDelete: Cascade)
  venueId     String?
  venue       Venue?      @relation(fields: [venueId], references: [id])
  homeTeamId  String?
  homeTeam    Team?       @relation("HomeTeam", fields: [homeTeamId], references: [id])
  awayTeamId  String?
  awayTeam    Team?       @relation("AwayTeam", fields: [awayTeamId], references: [id])
  status      MatchStatus @default(SCHEDULED)
  scheduledAt DateTime?
  startedAt   DateTime?
  completedAt DateTime?
  // Round-31 — audit trail for who/how the final score was accepted.
  // AUTO_AGREED → completedById is null (system); both captains' submissions
  // captured the timestamps.
  // ORGANIZER_REVIEW / ADMIN_OVERRIDE → completedById is the resolver.
  completedById   String?
  completedBy     User?               @relation("MatchCompletedBy", fields: [completedById], references: [id], onDelete: SetNull)
  completionMode  MatchCompletionMode?
  homeScore   Int?
  awayScore   Int?
  notes       String?
  // Round-20 — no-show / walkover bookkeeping.
  winType        MatchWinType @default(NORMAL)
  forfeitTeamId  String?
  forfeitTeam    Team?        @relation("ForfeitTeam", fields: [forfeitTeamId], references: [id])
  forfeitReason  String?
  createdAt   DateTime    @default(now())
  updatedAt   DateTime    @updatedAt

  // Round-14 — match-flow lineup gating.
  // Each side submits its lineup; the opponent's lineup stays hidden until
  // BOTH lineupSubmitted* timestamps are filled (lock).
  homeLineupSubmittedById String?
  homeLineupSubmittedAt   DateTime?
  awayLineupSubmittedById String?
  awayLineupSubmittedAt   DateTime?

  // Round-47 — lineup edit request flow. Once both lineups lock, a captain
  // can ask the opponent to re-open editing (e.g. a player can't make it).
  // The opponent approves or rejects via dedicated mutations. On approve,
  // BOTH lineup timestamps clear so both sides re-submit.
  lineupEditRequestedById  String?
  lineupEditRequestedAt    DateTime?
  lineupEditRequestedSide  String?
  // Round-60 — which block a pending lineup-edit request targets. Lineups are
  // now submitted per block (MatchBlockLineup), so a re-open re-opens only one
  // block. Reuses the lineupEditRequested* lifecycle above.
  lineupEditRequestedBlockOrder Int?

  frames       MatchFrame[]
  blockLineups MatchBlockLineup[]
  participants MatchParticipant[]
  scoreSubmissions MatchScoreSubmission[]
  rescheduleRequests MatchRescheduleRequest[]

  @@index([matchdayId])
  @@index([venueId])
  @@index([homeTeamId])
  @@index([awayTeamId])
  @@index([status])
  @@index([scheduledAt])
  @@map("matches")
}

model MatchFrame {
  id            String         @id @default(cuid())
  matchId       String
  match         Match          @relation(fields: [matchId], references: [id], onDelete: Cascade)
  frameNumber   Int
  // Frame TYPE comes from the competition's MatchFormatBlock at scaffold
  // time (Round-14). Nullable for legacy frames recorded before scaffolding.
  blockType     GameBlockType?
  // Round-60 — stable reference back to the originating MatchFormatBlock.order,
  // set at scaffold time. Lets the per-block lineup flow group frames by block
  // without re-walking the competition structure. Nullable for legacy frames
  // and INDIVIDUAL (1v1) competitions that have no blocks.
  blockOrder    Int?
  homeWon       Boolean?
  // Round-20 — per-frame walkover (e.g. an absent doubles partner). The
  // present side is awarded the frame; the UI surfaces a "Walkover" chip.
  isWalkover    Boolean      @default(false)
  // Round-47 — "break & run" flag (Figma MVP formula). When the winner
  // breaks the rack and runs out without letting the opponent shoot, set
  // this on the frame. Gated at the UI level on competition.breakAndRunRule.
  breakAndRun   Boolean      @default(false)
  homePlayer    String?
  awayPlayer    String?
  // Direct references to the picked players; falls back to homePlayer /
  // awayPlayer free-text when a roster ID isn't available.
  homePlayerId  String?
  homePlayerRef User?          @relation("FrameHomePlayer", fields: [homePlayerId], references: [id])
  awayPlayerId  String?
  awayPlayerRef User?          @relation("FrameAwayPlayer", fields: [awayPlayerId], references: [id])
  createdAt     DateTime       @default(now())
  updatedAt     DateTime       @updatedAt

  @@unique([matchId, frameNumber])
  @@index([matchId, blockOrder])
  @@map("match_frames")
}

// Round-60 — per-block, per-side lineup submission. A team match's lineup is
// now submitted one block at a time (pre-break Singles first, then Doubles,
// etc). One row per (match, side, block); a block is "published" once BOTH
// sides have a row, which unlocks winner entry for that block's frames.
model MatchBlockLineup {
  id            String   @id @default(cuid())
  matchId       String
  match         Match    @relation(fields: [matchId], references: [id], onDelete: Cascade)
  side          String   // "HOME" | "AWAY" (mirrors lineupEditRequestedSide)
  blockOrder    Int      // matches MatchFormatBlock.order
  submittedById String
  submittedBy   User     @relation("BlockLineupSubmittedBy", fields: [submittedById], references: [id])
  submittedAt   DateTime @default(now())
  updatedAt     DateTime @updatedAt

  @@unique([matchId, side, blockOrder])
  @@index([matchId])
  @@map("match_block_lineups")
}

model MatchParticipant {
  id           String   @id @default(cuid())
  matchId      String
  match        Match    @relation(fields: [matchId], references: [id], onDelete: Cascade)
  userId       String
  user         User     @relation(fields: [userId], references: [id])
  teamId       String?
  framesWon    Int      @default(0)
  framesPlayed Int      @default(0)
  createdAt    DateTime @default(now())

  @@unique([matchId, userId])
  @@index([userId])
  @@index([teamId])
  @@map("match_participants")
}

enum ScoreSubmissionStatus {
  PENDING
  AUTO_APPROVED
  APPROVED
  CONFLICT
  REJECTED
}

model MatchScoreSubmission {
  id             String                @id @default(cuid())
  matchId        String
  match          Match                 @relation(fields: [matchId], references: [id], onDelete: Cascade)
  submittedById  String
  submittedBy    User                  @relation("ScoreSubmittedBy", fields: [submittedById], references: [id])
  forTeamId      String
  forTeam        Team                  @relation("ScoreForTeam", fields: [forTeamId], references: [id])
  homeScore      Int
  awayScore      Int
  framesJson     Json?
  // Round-32 — captains attach photos of the scoresheet / scoreboard so the
  // result has a physical audit trail. Empty list means no evidence; conflicts
  // can still be resolved without photos.
  boardImageUrls String[] @default([])
  status         ScoreSubmissionStatus @default(PENDING)
  reviewedById   String?
  reviewedBy     User?                 @relation("ScoreReviewedBy", fields: [reviewedById], references: [id])
  reviewedAt     DateTime?
  note           String?
  createdAt      DateTime              @default(now())
  updatedAt      DateTime              @updatedAt

  // One submission per captain per match — a second submit overwrites it via upsert.
  @@unique([matchId, submittedById])
  @@index([matchId])
  @@index([status])
  @@map("match_score_submissions")
}

enum RescheduleRequestStatus {
  PENDING
  APPROVED
  REJECTED
  CANCELLED
}

model MatchRescheduleRequest {
  id             String                  @id @default(cuid())
  matchId        String
  match          Match                   @relation(fields: [matchId], references: [id], onDelete: Cascade)
  requestedById  String
  requestedBy    User                    @relation("RescheduleRequestedBy", fields: [requestedById], references: [id])
  proposedDate   DateTime
  reason         String?
  status         RescheduleRequestStatus @default(PENDING)
  reviewedById   String?
  reviewedBy     User?                   @relation("RescheduleReviewedBy", fields: [reviewedById], references: [id])
  reviewedAt     DateTime?
  createdAt      DateTime                @default(now())

  @@index([matchId])
  @@index([status])
  @@map("match_reschedule_requests")
}

// ─────────────────────────────────────────────────────────────────────────────
// Standings + player stats
// ─────────────────────────────────────────────────────────────────────────────

model Standing {
  id            String      @id @default(cuid())
  competitionId String
  competition   Competition @relation(fields: [competitionId], references: [id], onDelete: Cascade)
  teamId        String
  team          Team        @relation(fields: [teamId], references: [id])
  position      Int?
  played        Int         @default(0)
  won           Int         @default(0)
  drawn         Int         @default(0)
  lost          Int         @default(0)
  pointsFor     Int         @default(0)
  pointsAgainst Int         @default(0)
  pointDiff     Int         @default(0)
  points        Int         @default(0)
  updatedAt     DateTime    @updatedAt

  @@unique([competitionId, teamId])
  @@index([teamId])
  @@index([competitionId, points(sort: Desc)])
  @@map("standings")
}

model PlayerCompStat {
  id            String      @id @default(cuid())
  competitionId String
  competition   Competition @relation(fields: [competitionId], references: [id], onDelete: Cascade)
  userId        String
  user          User        @relation(fields: [userId], references: [id])
  matchesPlayed Int         @default(0)
  framesWon     Int         @default(0)
  framesPlayed Int         @default(0)
  // Round-47 — Figma MVP formula breakdown. `singlesWon` counts frames
  // won where blockType=SINGLES; `doublesWon` covers DOUBLES + SCOTCH_DOUBLES;
  // `brWon` counts frames won where breakAndRun=true (subset of frames-won).
  // `singlesPlayed`/`doublesPlayed` count participation (won or lost) so the
  // Players table can show PL/W/L/W% per category.
  // `mvpScore` = matchesPlayed + singlesWon*3 + doublesWon*2 + brWon*1.
  singlesPlayed Int         @default(0)
  singlesWon    Int         @default(0)
  doublesPlayed Int         @default(0)
  doublesWon    Int         @default(0)
  brWon         Int         @default(0)
  mvpScore      Int         @default(0)
  isMvp         Boolean     @default(false)

  @@unique([competitionId, userId])
  @@index([userId])
  @@index([isMvp])
  @@index([mvpScore])
  @@map("player_comp_stats")
}

// ─────────────────────────────────────────────────────────────────────────────
// Notifications
// ─────────────────────────────────────────────────────────────────────────────

model Notification {
  id          String                 @id @default(cuid())
  userId      String
  user        User                   @relation(fields: [userId], references: [id], onDelete: Cascade)
  type        NotificationType
  title       String
  message     String
  isRead      Boolean                @default(false)
  // Denormalized so the inbox can build a deeplink without an extra query.
  entityType  NotificationEntityType?
  entityId    String?
  entitySlug  String?
  // groupKey lets us collapse a fan-out across many recipients in the UI
  // ("3 updates on Spring Open"). Identical across all rows in the same event.
  groupKey    String?
  metadata    Json?
  createdAt   DateTime               @default(now())

  @@index([userId, isRead, createdAt(sort: Desc)])
  @@index([userId, groupKey])
  @@index([entityType, entityId])
  @@map("notifications")
}

enum NotificationChannel {
  IN_APP
  EMAIL
  DIGEST
}

/**
 * Per-(user, type, channel) opt-in/out. Missing rows imply the default
 * (everything in-app enabled, digest enabled, transactional emails off).
 * Mutating a row through the settings UI inserts/updates with isEnabled.
 */
model NotificationPreference {
  id          String              @id @default(cuid())
  userId      String
  user        User                @relation(fields: [userId], references: [id], onDelete: Cascade)
  type        NotificationType
  channel     NotificationChannel
  isEnabled   Boolean             @default(true)
  updatedAt   DateTime            @updatedAt
  createdAt   DateTime            @default(now())

  @@unique([userId, type, channel])
  @@index([userId])
  @@map("notification_preferences")
}

/**
 * One row per weekly digest sent. Lets us idempotently re-run a week without
 * duplicating sends; also a tidy place to drop telemetry (open/click) later.
 */
model DigestRun {
  id           String   @id @default(cuid())
  userId       String
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  weekStart    DateTime
  itemCount    Int
  sentAt       DateTime @default(now())
  status       String   @default("SENT")  // SENT / SKIPPED_EMPTY / FAILED
  failureNote  String?

  @@unique([userId, weekStart])
  @@index([weekStart])
  @@map("digest_runs")
}

/**
 * Round-47 — opaque single-use tokens for email-driven flows.
 *
 * `purpose` distinguishes verify-email from password-reset etc., so a leaked
 * verify token can't be replayed against the reset endpoint. Tokens are
 * stored as `tokenHash` (sha256) — the plaintext value only exists in the
 * outbound email body. Expiry is enforced at the resolver layer.
 */
model EmailToken {
  id        String   @id @default(cuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  purpose   String   // "VERIFY_EMAIL" | "PASSWORD_RESET"
  tokenHash String   @unique
  /// For VERIFY_EMAIL when the user changes email — the new pending address.
  /// Empty for other purposes.
  pendingEmail String?
  expiresAt DateTime
  usedAt    DateTime?
  createdAt DateTime @default(now())

  @@index([userId, purpose])
  @@map("email_tokens")
}

/**
 * Round-47 — auth + security audit log. One row per relevant attempt
 * (login ok/fail, password-reset request, rate-limit trip, ban evasion).
 * Kept thin on purpose so it can grow into the on-call dashboard later.
 * `userId` is null for unauthenticated events.
 */
model SecurityEvent {
  id        String   @id @default(cuid())
  userId    String?
  user      User?    @relation(fields: [userId], references: [id], onDelete: SetNull)
  /// "LOGIN_OK" | "LOGIN_FAIL" | "REGISTER" | "PASSWORD_RESET_REQUEST"
  /// | "PASSWORD_RESET_REDEEM" | "RATE_LIMITED"
  kind      String
  /// Identifier the request claimed (email / username). Useful for
  /// post-hoc enumeration analysis. Null for events without one.
  identifier String?
  ip        String?
  country   String?
  /// Free-form context (rule name, error code, etc.).
  note      String?
  createdAt DateTime @default(now())

  @@index([userId, createdAt])
  @@index([kind, createdAt])
  @@index([ip, createdAt])
  @@map("security_events")
}

// Round-54 — PlayerRatingHistory dropped along with the rating system.
// See migration 20260611140000_drop_player_rating.

// Round-49 — outgoing-email queue. One row per send; `template` selects
// the renderer in lib/services/email-queue.service.ts and `payload` carries
// the typed variables for that template (escaped at render-time, not now).
model OutgoingEmail {
  id          String              @id @default(cuid())
  template    String
  toEmail     String
  payload     Json
  status      OutgoingEmailStatus  @default(PENDING)
  attempts    Int                  @default(0)
  lastError   String?
  scheduledAt DateTime             @default(now())
  sentAt      DateTime?
  createdAt   DateTime             @default(now())
  updatedAt   DateTime             @updatedAt

  @@index([status, scheduledAt])
  @@map("outgoing_emails")
}
