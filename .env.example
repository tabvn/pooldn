# Copy to .env.local (dev) or .env.production.local (prod) and fill in.
# Never commit real values. See AGENTS.md for project conventions.

# ── Postgres ──────────────────────────────────────────────────────────────
# Local default: a Postgres role matching your OS username, no password,
# database named pooldn. Adjust as needed.
DATABASE_URL="postgresql://USER@localhost:5432/pooldn?schema=public"

# ── Auth ──────────────────────────────────────────────────────────────────
# 32+ random bytes. Rotate in production.
# Generate: `openssl rand -hex 32`
AUTH_SECRET="dev-secret-change-me"
# Optional — if unset, AUTH_SECRET is reused for refresh tokens too.
# AUTH_REFRESH_SECRET=""

# ── Public origin ─────────────────────────────────────────────────────────
# Absolute origin of the running app (no trailing slash). Used for links
# embedded in transactional email and similar off-site contexts. Defaults
# to the production hostname; override per environment.
NEXT_PUBLIC_APP_URL="https://pooldn.thebaycity.dev"

# ── Port ──────────────────────────────────────────────────────────────────
# Port the Next server listens on. Picked up by `next dev` / `next start`.
# Keep in sync with the Cloudflare tunnel target (currently 8084 in prod).
PORT=3000

# ── Email (Gmail SMTP) ────────────────────────────────────────────────────
# Used for email verification + password reset + ban notifications. Gmail
# requires an App Password (16-char). Enable 2-Step Verification then
# generate at https://myaccount.google.com/apppasswords. Leave SMTP_USER
# blank in dev — the service falls back to logging the email body to the
# server console instead of sending.
SMTP_HOST="smtp.gmail.com"
SMTP_PORT="465"
SMTP_SECURE="true"
SMTP_USER=""
SMTP_PASSWORD=""
SMTP_FROM_NAME="PoolDN"

# ── Rate-limit / Redis ────────────────────────────────────────────────────
# A single Redis instance is shared across multiple thebay.city projects.
# Every key written by this app is prefixed with RATE_LIMIT_PREFIX so we
# never collide with siblings. Leave REDIS_URL blank in dev — the limiter
# falls back to an in-memory bucket which is fine for a single-node dev
# server but loses state on every reload.
REDIS_URL=""
RATE_LIMIT_PREFIX="pooldn:rl:"

# ── Cron (optional) ───────────────────────────────────────────────────────
# CRON_SECRET=""

# ── Google Sign-In (OAuth 2.0 / OIDC) ─────────────────────────────────────
# Create an OAuth client (type: Web application) in Google Cloud Console for
# project "pooldn". Authorized redirect URIs (must match exactly):
#   https://pooldn.thebaycity.dev/api/auth/google/callback
#   http://localhost:3000/api/auth/google/callback
# Then paste the values into .env (NOT .env.example — keep the secret out of git).
GOOGLE_CLIENT_ID=""
GOOGLE_CLIENT_SECRET=""

# ── Facebook Login (OAuth 2.0) ────────────────────────────────────────────
# Create an app at developers.facebook.com → add "Facebook Login" → Settings.
# Valid OAuth Redirect URIs (must match exactly):
#   https://pooldn.thebaycity.dev/api/auth/facebook/callback
#   http://localhost:3000/api/auth/facebook/callback
# The `email` permission needs App Review before public use.
FACEBOOK_CLIENT_ID=""
FACEBOOK_CLIENT_SECRET=""
# FACEBOOK_GRAPH_VERSION="v21.0"   # optional; bump as Facebook deprecates versions
