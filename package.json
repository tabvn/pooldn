{
  "name": "pooldn",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint",
    "db:migrate": "prisma migrate dev",
    "db:seed": "prisma db seed",
    "db:reset": "prisma migrate reset --force",
    "schema:print": "tsx scripts/print-schema.ts",
    "schema:watch": "nodemon --quiet --watch lib/graphql/builder.ts --watch lib/graphql/context.ts --watch lib/graphql/schema.ts --watch lib/graphql/types --watch lib/graphql/resolvers --ext ts --exec \"npm run schema:print\"",
    "codegen": "npm run schema:print && graphql-codegen --config codegen.ts",
    "codegen:watch": "npm run schema:print && concurrently -k -n schema,codegen -c yellow,cyan \"npm:schema:watch\" \"graphql-codegen --config codegen.ts --watch\"",
    "test:e2e": "playwright test",
    "test:e2e:ui": "playwright test --ui"
  },
  "dependencies": {
    "@apollo/client": "^4.2.2",
    "@apollo/client-integration-nextjs": "^0.14.5",
    "@base-ui-components/react": "^1.0.0-rc.0",
    "@base-ui/react": "^1.5.0",
    "@casl/ability": "^7.0.0",
    "@casl/prisma": "^2.0.1",
    "@casl/react": "^7.0.0",
    "@dnd-kit/core": "^6.3.1",
    "@dnd-kit/sortable": "^10.0.0",
    "@dnd-kit/utilities": "^3.2.2",
    "@hookform/resolvers": "^5.4.0",
    "@pothos/core": "^4.12.0",
    "@pothos/plugin-prisma": "^4.14.3",
    "@prisma/client": "^6.19.3",
    "bcryptjs": "^3.0.3",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "graphql": "^16.14.1",
    "graphql-scalars": "^1.25.0",
    "graphql-yoga": "^5.21.1",
    "jose": "^6.2.3",
    "lucide-react": "^1.17.0",
    "next": "16.2.7",
    "react": "19.2.4",
    "react-dom": "19.2.4",
    "react-hook-form": "^7.78.0",
    "shadcn": "^4.10.0",
    "tailwind-merge": "^3.6.0",
    "tw-animate-css": "^1.4.0",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@graphql-codegen/cli": "^7.1.2",
    "@graphql-codegen/client-preset": "^6.0.1",
    "@parcel/watcher": "^2.5.6",
    "@playwright/test": "^1.60.0",
    "@tailwindcss/postcss": "^4",
    "@types/bcryptjs": "^2.4.6",
    "@types/node": "^20",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "concurrently": "^10.0.3",
    "dotenv": "^17.4.2",
    "eslint": "^9",
    "eslint-config-next": "16.2.7",
    "nodemon": "^3.1.14",
    "prisma": "^6.19.3",
    "tailwindcss": "^4",
    "tsx": "^4.22.4",
    "typescript": "^5"
  }
}
