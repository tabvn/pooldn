# ─────────────────────────────────────────────────────────────────────────────
# PoolDN — docker compose production config.
#
#   cp .env.docker.example .env.docker    # then fill in the real values
#   docker compose --env-file .env.docker up -d --build
#
# DATABASE_URL and REDIS_URL are NOT set here — docker-compose.yml points them
# at the `db` and `redis` services on the compose network. Anything you put
# here for those two is ignored.
# ─────────────────────────────────────────────────────────────────────────────

# ── Public origin ─────────────────────────────────────────────────────────
# Read at BUILD time (NEXT_PUBLIC_* is inlined into the client bundle), so
# changing this needs `docker compose up -d --build`, not just a restart.
NEXT_PUBLIC_APP_URL="https://pooldn.com"

# Extra origins the app also answers on, comma-separated, each with a scheme.
# Every origin here must also be a registered redirect URI in the Google and
# Facebook consoles.
#
# This list gates the session, not just OAuth: a request arriving on a host
# that is not NEXT_PUBLIC_APP_URL and not listed here renders as a GUEST even
# with a valid cookie. That is why http://localhost:9084 shows the signed-out
# dashboard — add it here temporarily if you want to smoke-test signed-in
# pages against the container without a proxy in front.
APP_ORIGIN_ALLOWLIST="https://www.pooldn.com"

# ── Auth ──────────────────────────────────────────────────────────────────
# Generate fresh ones:  openssl rand -hex 32
# Rotating either invalidates every signed cookie — everyone gets logged out.
AUTH_SECRET="CHANGE_ME_openssl_rand_hex_32"
AUTH_REFRESH_SECRET="CHANGE_ME_openssl_rand_hex_32"

# ── Database refresh ──────────────────────────────────────────────────────
# true  → drop the schema, replay all migrations, NO demo seed, then recreate
#         the admin below. Destructive. Set it for one run, then unset.
# false → `prisma migrate deploy` only (the normal path).
RESET_DB="false"

# ── Admin bootstrap ───────────────────────────────────────────────────────
# The only account the stack creates. Everything else is made in-app.
# The password is written on first creation only — set ADMIN_FORCE_PASSWORD
# to true for one run if you need to reset it.
ADMIN_USERNAME="admin"
ADMIN_EMAIL="toan@thebay.city"
ADMIN_NAME="PoolDN Admin"
ADMIN_PASSWORD="CHANGE_ME"
ADMIN_NATIONALITY="VN"
ADMIN_FORCE_PASSWORD="false"

# Bootstrap city. City is PoolDN's top-level content filter and the header
# selector auto-pins when exactly one active city exists — so one city here
# is the intended production starting state.
SEED_COUNTRY_CODE="VN"
SEED_COUNTRY_NAME="Vietnam"
SEED_CITY_NAME="Da Nang"

# ── Email (Gmail SMTP) ────────────────────────────────────────────────────
# Without SMTP_USER/SMTP_PASSWORD the mailer just logs to stdout.
SMTP_HOST="smtp.gmail.com"
SMTP_PORT="465"
SMTP_SECURE="true"
SMTP_USER=""
SMTP_PASSWORD=""
SMTP_FROM_NAME="PoolDN"

# ── Rate limiting ─────────────────────────────────────────────────────────
RATE_LIMIT_PREFIX="pooldn:rl:"

# ── OAuth ─────────────────────────────────────────────────────────────────
GOOGLE_CLIENT_ID=""
GOOGLE_CLIENT_SECRET=""
FACEBOOK_CLIENT_ID=""
FACEBOOK_CLIENT_SECRET=""

# ── Cron ──────────────────────────────────────────────────────────────────
# Required header secret for /api/cron/weekly-digest. Leave empty to allow
# unauthenticated triggers (not recommended in prod).
CRON_SECRET=""
